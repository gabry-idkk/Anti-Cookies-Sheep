{
  "manifest_version": 3,
  "name": "Anti-Cookies Sheep",
  "short_name": "AntiCookies",
  "version": "1.0.0",
  "description": "Blocca cookie di terze parti, tracker, fingerprinting, CNAME cloaking e domini di telemetria. Impostazioni per sito, whitelist e statistiche live.",
  "default_locale": "it",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "privacy",
    "browsingData",
    "contentSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Anti-Cookies Sheep",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/inject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "trackers",
        "enabled": true,
        "path": "src/rules/trackers.json"
      },
      {
        "id": "telemetry",
        "enabled": true,
        "path": "src/rules/telemetry.json"
      }
    ]
  }
}
